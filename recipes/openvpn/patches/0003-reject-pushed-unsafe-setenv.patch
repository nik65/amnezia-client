From 4f7dfd340539801670a198a76cc816821b57a47f Mon Sep 17 00:00:00 2001
From: Amnezia VPN <dev@amnezia.org>
Date: Tue, 21 Jul 2026 20:00:00 +0300
Subject: [PATCH] Reject unsafe setenv directives received from a server

Pull filters run against the raw option text before parse_line() canonicalizes
quotes and backslash escapes.  A hostile server can therefore spell the first
token as 'setenv' or s\etenv, bypass a prefix filter, and still reach the
ordinary setenv handler.  Refuse that semantic directive in pull mode while
retaining the explicitly safe setenv-safe form.
---
 src/openvpn/options.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/openvpn/options.c b/src/openvpn/options.c
index 85065fd5..80f1a559 100644
--- a/src/openvpn/options.c
+++ b/src/openvpn/options.c
@@ -7054,6 +7054,13 @@ add_option(struct options *options,
     else if (streq(p[0], "setenv") && p[1] && !p[3])
     {
         VERIFY_PERMISSION(OPT_P_GENERAL);
+        if (pull_mode)
+        {
+            msg(msglevel,
+                "Unsafe pushed setenv directive rejected; use setenv-safe instead");
+            goto err;
+        }
+
         if (streq(p[1], "REMOTE_RANDOM_HOSTNAME") && !p[2])
         {
             options->sockflags |= SF_HOST_RANDOMIZE;
--
