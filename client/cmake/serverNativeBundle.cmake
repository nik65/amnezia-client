# Import reviewed artifacts only. Never build, download, execute, or publish them.
set(AMNEZIA_SERVER_NATIVE_BUNDLE_DIR "" CACHE PATH "Reviewed static Linux server native resource bundle")

function(_amnezia_native_fail reason)
    message(FATAL_ERROR "Invalid AMNEZIA_SERVER_NATIVE_BUNDLE_DIR: ${reason}")
endfunction()

function(_amnezia_native_no_links path)
    set(cursor "${path}")
    while(NOT cursor STREQUAL "")
        if(IS_SYMLINK "${cursor}")
            _amnezia_native_fail("symbolic link in ${path}")
        endif()
        cmake_path(GET cursor PARENT_PATH parent)
        if(parent STREQUAL cursor)
            break()
        endif()
        set(cursor "${parent}")
    endwhile()
endfunction()

function(_amnezia_native_xml value output)
    string(REPLACE "&" "&amp;" value "${value}")
    string(REPLACE "<" "&lt;" value "${value}")
    string(REPLACE ">" "&gt;" value "${value}")
    string(REPLACE "\"" "&quot;" value "${value}")
    string(REPLACE "'" "&apos;" value "${value}")
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

# Coordinates are bounded to signed 63 bits; the runtime validator additionally
# supports the full ELF uint64 domain. This importer deliberately fails closed.
function(_amnezia_native_le hex offset width output)
    math(EXPR start "${offset} * 2")
    math(EXPR length "${width} * 2")
    string(SUBSTRING "${hex}" ${start} ${length} bytes)
    set(reversed "")
    math(EXPR last "${width} - 1")
    foreach(i RANGE 0 ${last})
        math(EXPR index "${i} * 2")
        string(SUBSTRING "${bytes}" ${index} 2 byte)
        string(PREPEND reversed "${byte}")
    endforeach()
    if(width EQUAL 8 AND reversed MATCHES "^[89abcdef]")
        _amnezia_native_fail("ELF coordinate exceeds signed importer domain")
    endif()
    math(EXPR value "0x${reversed}")
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(_amnezia_native_elf path architecture size)
    file(READ "${path}" header LIMIT 64 HEX)
    string(SUBSTRING "${header}" 0 14 magic)
    if(NOT magic STREQUAL "7f454c46020101")
        _amnezia_native_fail("not ELF64 little endian version 1")
    endif()
    foreach(spec "7;1;abi" "8;1;abiversion" "16;2;type" "18;2;machine" "20;4;version" "24;8;entry" "32;8;table" "52;2;ehsize" "54;2;phsize" "56;2;count")
        list(GET spec 0 offset)
        list(GET spec 1 width)
        list(GET spec 2 name)
        _amnezia_native_le("${header}" ${offset} ${width} ${name})
    endforeach()
    if(architecture STREQUAL "x86_64")
        set(expected_machine 62)
    else()
        set(expected_machine 183)
    endif()
    if(NOT (abi EQUAL 0 OR abi EQUAL 3) OR NOT abiversion EQUAL 0 OR NOT type EQUAL 2 OR NOT machine EQUAL expected_machine OR NOT version EQUAL 1 OR NOT ehsize EQUAL 64 OR NOT phsize EQUAL 56 OR count LESS 1 OR count GREATER 128 OR table LESS 64 OR table GREATER size)
        _amnezia_native_fail("unsupported ELF header")
    endif()
    math(EXPR end "${table} + ${count} * 56")
    if(end GREATER size)
        _amnezia_native_fail("ELF program table outside file")
    endif()
    set(entry_found FALSE)
    math(EXPR last "${count} - 1")
    foreach(i RANGE 0 ${last})
        math(EXPR at "${table} + ${i} * 56")
        file(READ "${path}" ph OFFSET ${at} LIMIT 56 HEX)
        foreach(spec "0;4;kind" "4;4;flags" "8;8;offset" "16;8;address" "32;8;filesize" "40;8;memorysize" "48;8;alignment")
            list(GET spec 0 field_offset)
            list(GET spec 1 width)
            list(GET spec 2 name)
            _amnezia_native_le("${ph}" ${field_offset} ${width} ${name})
        endforeach()
        if(kind EQUAL 2 OR kind EQUAL 3 OR offset GREATER size)
            _amnezia_native_fail("dynamic/interpreted ELF or invalid segment")
        endif()
        math(EXPR remaining "${size} - ${offset}")
        if(filesize GREATER remaining)
            _amnezia_native_fail("ELF segment outside file")
        endif()
        if(kind EQUAL 1)
            if(architecture STREQUAL "x86_64")
                set(page_size 4096)
            else()
                set(page_size 65536)
            endif()
            math(EXPR offset_page "${offset} % ${page_size}")
            math(EXPR address_page "${address} % ${page_size}")
            math(EXPR maximum_memory "9223372036854775807 - ${address}")
            if(NOT offset_page EQUAL address_page OR memorysize GREATER maximum_memory)
                _amnezia_native_fail("ELF load mapping overflow or page incongruence")
            endif()
            if(alignment GREATER 1)
                math(EXPR alignment_mask "${alignment} & (${alignment} - 1)")
                math(EXPR offset_alignment "${offset} % ${alignment}")
                math(EXPR address_alignment "${address} % ${alignment}")
                if(NOT alignment_mask EQUAL 0 OR NOT offset_alignment EQUAL address_alignment)
                    _amnezia_native_fail("ELF invalid load alignment")
                endif()
            endif()
            if(filesize GREATER memorysize)
                _amnezia_native_fail("ELF segment file size exceeds memory size")
            endif()
            math(EXPR executable "${flags} & 1")
            if(executable AND entry GREATER_EQUAL address)
                math(EXPR relative "${entry} - ${address}")
                if(relative LESS filesize)
                    set(entry_found TRUE)
                endif()
            endif()
        endif()
    endforeach()
    if(NOT entry_found)
        _amnezia_native_fail("ELF entry is not in executable file-backed PT_LOAD")
    endif()
endfunction()

function(amnezia_import_server_native_bundle output)
    set(${output} "" PARENT_SCOPE)
    if(AMNEZIA_SERVER_NATIVE_BUNDLE_DIR STREQUAL "")
        return()
    endif()
    set(root "${AMNEZIA_SERVER_NATIVE_BUNDLE_DIR}")
    file(TO_CMAKE_PATH "${root}" root)
    if(NOT IS_ABSOLUTE "${root}" OR NOT IS_DIRECTORY "${root}" OR root MATCHES ";" OR root MATCHES "[\r\n]" OR root MATCHES [=[(^|/)\.\.(/|$)]=])
        _amnezia_native_fail("expected absolute directory without list/newline characters")
    endif()
    cmake_path(NORMAL_PATH root)
    _amnezia_native_no_links("${root}")
    set(manifest "${root}/manifest.json")
    _amnezia_native_no_links("${manifest}")
    if(NOT EXISTS "${manifest}" OR IS_DIRECTORY "${manifest}")
        _amnezia_native_fail("missing manifest.json")
    endif()
    file(SIZE "${manifest}" manifest_size)
    if(manifest_size LESS 1 OR manifest_size GREATER 16384)
        _amnezia_native_fail("manifest size outside 1..16384")
    endif()
    file(READ "${manifest}" json LIMIT 16385)
    string(JSON schema ERROR_VARIABLE error GET "${json}" schema)
    if(error OR NOT schema STREQUAL "1")
        _amnezia_native_fail("manifest schema")
    endif()
    string(JSON count ERROR_VARIABLE error LENGTH "${json}" binaries)
    if(error OR count LESS 1 OR count GREATER 6)
        _amnezia_native_fail("manifest binaries must contain 1..6 rows")
    endif()
    set(canonical "{\"binaries\":[")
    _amnezia_native_xml("${manifest}" escaped)
    set(qrc "<RCC><qresource prefix=\"/server_native\"><file alias=\"manifest.json\">${escaped}</file>")
    set(identities "")
    math(EXPR last "${count} - 1")
    foreach(i RANGE 0 ${last})
        foreach(key architecture path role sha256 size)
            string(JSON ${key} ERROR_VARIABLE error GET "${json}" binaries ${i} ${key})
            if(error)
                _amnezia_native_fail("missing binary field ${key}")
            endif()
        endforeach()
        if(NOT architecture MATCHES "^(x86_64|aarch64)$" OR NOT role MATCHES "^(collector|collector-route|awg-feed)$" OR NOT path STREQUAL "${architecture}/${role}" OR path IN_LIST identities)
            _amnezia_native_fail("binary identity/path or duplicate")
        endif()
        string(LENGTH "${sha256}" hash_length)
        if(NOT hash_length EQUAL 64 OR NOT sha256 MATCHES "^[0-9a-f]+$" OR NOT size MATCHES "^[0-9]+$" OR size LESS 64 OR size GREATER 33554432)
            _amnezia_native_fail("binary hash/size")
        endif()
        list(APPEND identities "${path}")
        set(binary "${root}/${path}")
        _amnezia_native_no_links("${binary}")
        if(NOT EXISTS "${binary}" OR IS_DIRECTORY "${binary}")
            _amnezia_native_fail("missing binary ${path}")
        endif()
        file(SIZE "${binary}" actual_size)
        if(NOT actual_size EQUAL size)
            _amnezia_native_fail("binary size mismatch")
        endif()
        file(SHA256 "${binary}" actual_hash)
        if(NOT actual_hash STREQUAL sha256)
            _amnezia_native_fail("binary hash mismatch")
        endif()
        _amnezia_native_elf("${binary}" "${architecture}" "${size}")
        if(i GREATER 0)
            string(APPEND canonical ",")
        endif()
        string(APPEND canonical "{\"architecture\":\"${architecture}\",\"path\":\"${path}\",\"role\":\"${role}\",\"sha256\":\"${sha256}\",\"size\":${size}}")
        _amnezia_native_xml("${binary}" escaped)
        string(APPEND qrc "<file alias=\"${path}\">${escaped}</file>")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${binary}")
    endforeach()
    string(APPEND canonical "],\"schema\":1}")
    if(NOT json STREQUAL canonical AND NOT json STREQUAL "${canonical}\n")
        _amnezia_native_fail("manifest must be canonical compact JSON (unknown/duplicate fields forbidden)")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
    string(APPEND qrc "</qresource></RCC>\n")
    set(destination "${CMAKE_CURRENT_BINARY_DIR}/serverNativeBundle.qrc")
    file(WRITE "${destination}" "${qrc}")
    set(${output} "${destination}" PARENT_SCOPE)
endfunction()
