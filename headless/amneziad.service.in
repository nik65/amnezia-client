[Unit]
Description=AmneziaVPN headless system daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=amnezia
RuntimeDirectory=amnezia
RuntimeDirectoryMode=0750
StateDirectory=amnezia
StateDirectoryMode=0750
UMask=0007
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/amneziad --socket /run/amnezia/amneziad.sock --store /var/lib/amnezia/profiles.json --config-root /etc/amnezia/profiles --require-root-owned-config --staging-root /run/amnezia
Restart=on-failure
RestartSec=2
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/amnezia /run/amneziawg /var/lib/amnezia
ReadWritePaths=@CMAKE_INSTALL_FULL_BINDIR@

[Install]
WantedBy=multi-user.target
