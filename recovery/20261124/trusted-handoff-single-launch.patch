+def prepare_install_script(context, *, expected_client_sha256, destination, python_path):
+    """Prepare one user-run Windows action without repacking the tested EXE."""
+    from .trusted_acquisition_export import SHA
+    if not isinstance(expected_client_sha256, str) or not SHA.fullmatch(expected_client_sha256):
+        raise TrustedAcquisitionError("exact tested Windows GUI SHA required")
+    approval_path = context.bundle / "release-acceptance.json"
+    approval_record = file_record(approval_path)
+    verify_full_acceptance(read_json(approval_path, 128 * 1024), context=context)
+    verifier = Path(__file__).absolute()
+    repo = verifier.parents[2]
+    protected = [file_record(path) for path in (
+        verifier, verifier.with_name("trusted_acquisition_export.py"),
+        verifier.with_name("android_real_device_acquisition.py"),
+        repo / "deploy/selfhosted_updates/make_manifest.py", context.public_key,
+    )]
+    config = {
+        "outer": context.outer,
+        "trustedFiles": [*protected, context.manifest, approval_record],
+        "verifierRoot": str(repo),
+        "verifierArguments": [
+            "--bundle", str(context.bundle), "--outer", context.outer["path"],
+            "--publisher", context.publisher["path"], "--public-key", str(context.public_key),
+        ],
+        "python": str(python_path),
+        "installedRoot": r"C:\Program Files\AmneziaVPN",
+        "clientSha256": expected_client_sha256,
+        "approval": approval_record,
+        "installedBundleFiles": [{**context.manifest, "path": "manifest.json"}, *context.artifacts],
+    }
+    template = verifier.with_name("install_selfhosted_handoff.ps1").read_text(encoding="utf-8-sig")
+    token = "__AMNEZIA_HANDOFF_CONFIG__"
+    if template.count(token) != 1:
+        raise TrustedAcquisitionError("install handoff template changed")
+    encoded = base64.b64encode(canonical(config)).decode("ascii")
+    write_new(destination, template.replace(token, encoded).encode("utf-8-sig"))
+    return file_record(Path(destination).absolute())
+
+
