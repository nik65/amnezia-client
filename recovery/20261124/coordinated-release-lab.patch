+def verify_android_release_export(run: Mapping[str, Any], path: Path) -> str:
+    """Verify an original physical-device export against this release plan."""
+    if not __package__:  # The Windows wrapper also invokes lab.py as a script.
+        sys.path.insert(0, str(repo_root()))
+    try:
+        from deploy.release_lab import trusted_acquisition_export as authority
+        from deploy.release_lab.android_real_device_acquisition import AndroidAcquisitionError
+    finally:
+        if not __package__:
+            sys.path.pop(0)
+    try:
+        info = path.lstat()
+        if (not stat.S_ISREG(info.st_mode) or getattr(info, "st_file_attributes", 0) & 0x400
+                or not 0 < info.st_size <= authority.MAX_EXPORT_BYTES):
+            raise LabError("Android acquisition export must be a regular file within bounds")
+        with path.open("rb") as stream:
+            raw = stream.read(authority.MAX_EXPORT_BYTES + 1)
+        if len(raw) != info.st_size:
+            raise LabError("Android acquisition export changed during read")
+        envelope = json.loads(raw)
+        if raw != authority.canonical(envelope):
+            raise LabError("original canonical signed Android acquisition export required")
+        manifest = Path(run["manifest"]["path"])
+        context = authority.AcquisitionContext.load(
+            bundle=manifest.parent, outer=Path(run["outer_artifact"]["path"]),
+            publisher=repo_root() / "deploy/selfhosted_updates/publish_bundled_release.sh",
+            public_key=Path(run["manifest_public_key"]["path"]),
+        )
+        if (context.version != run["candidate_version"] or context.manifest != run["manifest"]
+                or context.outer != run["outer_artifact"] or context.public_key_record != run["manifest_public_key"]):
+            raise LabError("Android acquisition context differs from the exact release plan")
+        for platform, planned in run["artifacts"].items():
+            candidate = context.candidate(platform)
+            if (candidate["sha256"], candidate["size"]) != (planned.get("sha256"), planned.get("size")):
+                raise LabError(f"Android acquisition context differs from planned artifact: {platform}")
+        payload = authority.verify_export(envelope, context=context)
+        if payload["target"] != "android" or payload["profileId"] != "android-real-device":
+            raise LabError("signed Android real-device profile required")
+        return payload["expiresAt"]
+    except (authority.TrustedAcquisitionError, AndroidAcquisitionError, OSError, ValueError,
+            KeyError, TypeError, AttributeError, RecursionError, SystemExit) as exc:
+        raise LabError(f"Android real-device export rejected: {exc}") from exc
+
