+def parse_loopback_server_ssh_pin(output: str) -> str:
+    """Derive the OpenSSH fingerprint from one loopback Ed25519 keyscan record."""
+    fields = output.split()
+    if len(output) > 256 or len(output.splitlines()) != 1 or len(fields) != 3:
+        raise LabError("expected one isolated server SSH keyscan record")
+    if fields[:2] != ["127.0.0.1", "ssh-ed25519"]:
+        raise LabError("unexpected isolated server SSH endpoint or key type")
+    try:
+        key = base64.b64decode(fields[2], validate=True)
+    except ValueError as exc:
+        raise LabError("invalid isolated server Ed25519 public key") from exc
+    wire_prefix = b"\x00\x00\x00\x0bssh-ed25519\x00\x00\x00\x20"
+    if (not key.startswith(wire_prefix) or len(key) != len(wire_prefix) + 32
+            or base64.b64encode(key).decode("ascii") != fields[2]):
+        raise LabError("invalid isolated server Ed25519 public key")
+    return "SHA256:" + base64.b64encode(hashlib.sha256(key).digest()).decode("ascii").rstrip("=")
+
