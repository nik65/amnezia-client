@@ -130,3 +130,47 @@ def issue_coordinated_acceptance(*, private_key, **inputs):
     envelope = authority.make_manifest.acceptance_envelope(payload, Path(private_key))
     authority.verify_full_acceptance(envelope, context=context)
     return envelope, proof
+
+
+def _received_object(raw, *, label, maximum):
+    if not isinstance(raw, bytes) or not 0 < len(raw) <= maximum:
+        raise authority.TrustedAcquisitionError(f"{label} requires original bytes within bounds")
+    value = authority._json(raw)
+    if not isinstance(value, dict):
+        raise authority.TrustedAcquisitionError(f"{label} must be a JSON object")
+    return value
+
+
+def verify_coordinated_approval(*, context, approval_bytes, windows_bytes, gui_bytes,
+                               coordinated_headless_bytes, android_bytes):
+    """Verify an existing approval against the original four current exports.
+
+    The caller supplies the pinned acquisition context. No file placement or
+    signing occurs here. Successful verification leaves the input bytes safe
+    to pass unchanged to a separately guarded publication fixture.
+    """
+    approval = _received_object(approval_bytes, label="detached approval", maximum=128 * 1024)
+    if approval_bytes != authority.canonical(approval):
+        raise authority.TrustedAcquisitionError("canonical detached approval bytes required")
+    payload = authority.verify_full_acceptance(approval, context=context)
+
+    def export(raw, label):
+        return _received_object(raw, label=label, maximum=authority.MAX_EXPORT_BYTES)
+
+    receipts, proof, source_expiry = prepare_coordinated_matrix(
+        context=context, windows_export=export(windows_bytes, "Windows export"),
+        gui_export=export(gui_bytes, "Linux GUI export"),
+        coordinated_headless_export=export(coordinated_headless_bytes, "coordinated headless export"),
+        android_export=export(android_bytes, "physical Android export"),
+        original_android_context=context, original_android_bytes=android_bytes,
+    )
+    if authority.canonical(payload["receipts"]) != authority.canonical(receipts):
+        raise authority.TrustedAcquisitionError("detached approval receipts differ from the four verified observations")
+    issued = authority._utc(payload["issuedAt"])
+    expires = authority._utc(payload["expiresAt"])
+    latest_observation = max(authority._utc(item["payload"]["issuedAt"]) for item in proof["observations"])
+    if issued < latest_observation or expires > min(issued + timedelta(hours=1), source_expiry):
+        raise authority.TrustedAcquisitionError("detached approval lifetime differs from its coordinated observations")
+    if authority.utc_now() >= expires:
+        raise authority.TrustedAcquisitionError("detached approval expired during verification")
+    return payload, proof
