set(_qtiff "${CPACK_TEMPORARY_DIRECTORY}/packages/AmneziaVPN/data/plugins/imageformats/libqtiff.so")
if(NOT EXISTS "${_qtiff}" OR IS_SYMLINK "${_qtiff}")
    message(FATAL_ERROR "Expected staged Qt TIFF plugin is missing or ambiguous: ${_qtiff}")
endif()
file(READ "${_qtiff}" _magic HEX OFFSET 0 LIMIT 4)
if(NOT _magic STREQUAL "7f454c46")
    message(FATAL_ERROR "Staged Qt TIFF plugin is not an ELF file: ${_qtiff}")
endif()
file(SHA256 "${_qtiff}" _actual_sha256)
if(NOT _actual_sha256 STREQUAL "@AMNEZIA_QTIFF_EXPECTED_SHA256@")
    message(FATAL_ERROR "Staged Qt TIFF plugin differs from the selected Qt kit")
endif()
file(REMOVE "${_qtiff}")
if(EXISTS "${_qtiff}")
    message(FATAL_ERROR "Failed to remove staged Qt TIFF plugin")
endif()
