[Unit]
Description=Amnezia authenticated VLESS gateway for DNS fallback
After=network-online.target sing-box.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
LoadCredential=gateway.json:/etc/amnezia/dns-transport/gateway.json
ExecStart=/usr/bin/sing-box run -c ${CREDENTIALS_DIRECTORY}/gateway.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# sing-box subscribes to route notifications; AF_NETLINK is required even for SOCKS.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
MemoryMax=256M
CPUQuota=50%
TasksMax=64
LimitNOFILE=1024
UMask=0077
Environment=GOMAXPROCS=2
Environment=GOMEMLIMIT=128MiB

[Install]
WantedBy=multi-user.target
