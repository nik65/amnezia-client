#cloud-config
preserve_hostname: false
hostname: amnezia-server-router
timezone: UTC
package_update: true
package_reboot_if_required: false
packages:
  - ca-certificates
  - curl
  - openssh-server
  - python3
  - qemu-guest-agent
  - iproute2
  - iputils-ping
  - docker.io
  - sudo
ssh_pwauth: false
disable_root: true
users:
  - name: lab
    gecos: Amnezia isolated test server operator
    groups: [adm, docker, sudo]
    lock_passwd: true
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD: ALL"]
    ssh_authorized_keys:
      - __LAB_SSH_PUBLIC_KEY__
write_files:
  - path: /etc/amnezia-lab/profile
    permissions: '0644'
    content: |
      profile=server-router
      image=ubuntu24-cloud-amd64
      network_phase=pre-seal
      wan_after_seal=disabled
      candidate_credentials=absent
      busybox_image=docker.io/library/busybox@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662
  - path: /usr/local/sbin/amnezia-lab-guest-marker
    permissions: '0755'
    content: |
      #!/bin/sh
      set -eu
      install -d -m 0755 /var/lib/amnezia-lab
      systemctl is-active --quiet docker.service
      systemctl is-active --quiet qemu-guest-agent.service
      docker image inspect docker.io/library/busybox@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662 >/dev/null
      runuser -u lab -- sudo -n true
      tmp=$(mktemp /var/lib/amnezia-lab/.READY.XXXXXX)
      printf '%s\n' "profile=server-router" "image=ubuntu24-cloud-amd64" "phase=ready" "wan_after_seal=disabled" "candidate_credentials=absent" "docker_service=running" "qga_service=running" "passwordless_sudo=verified" "busybox_image=docker.io/library/busybox@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662" "router_mode=guest-only" "os_ready=true" > "$tmp"
      chmod 0644 "$tmp"
      mv -f "$tmp" /var/lib/amnezia-lab/READY
runcmd:
  - [systemctl, enable, --now, docker.service]
  - [systemctl, enable, --now, qemu-guest-agent.service]
  - [docker, pull, docker.io/library/busybox@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662]
  - [docker, image, inspect, docker.io/library/busybox@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662]
  - [/usr/local/sbin/amnezia-lab-guest-marker]
final_message: 'amnezia-lab server-router provisioning complete; seal and remove WAN before candidate testing'
