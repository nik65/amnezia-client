PROFILE_ID=linux-x64-gui
OS_FAMILY=linux
BASE_IMAGE=ubuntu24-cloud-amd64
MEMORY_MIB=6144
VCPUS=4
DISK_GIB=48
# Headless automation consumes screenshots through a private VNC/QMP socket;
# a human may open a viewer explicitly when diagnosing a guest.
DISPLAY=vnc-unix
NIC_MODEL=e1000
NETWORK_MODE=lab-nat-before-seal
POST_SEAL_WAN=disabled
QMP_SOCKET=qmp/linux-gui.sock
QGA_SOCKET=qga/linux-gui.sock
UEFI=off
TPM=off
SNAPSHOT_POLICY=golden-read-only-plus-ephemeral-run
