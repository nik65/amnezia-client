# shell-readable profile; consumed by provisioning/controller tooling
PROFILE_ID=linux-headless-x64
OS_FAMILY=linux
BASE_IMAGE=ubuntu24-cloud-amd64
MEMORY_MIB=4096
VCPUS=2
DISK_GIB=32
DISPLAY=none
NIC_MODEL=e1000
NETWORK_MODE=lab-nat-before-seal
POST_SEAL_WAN=disabled
QMP_SOCKET=qmp/linux-headless.sock
QGA_SOCKET=qga/linux-headless.sock
UEFI=off
TPM=off
SNAPSHOT_POLICY=golden-read-only-plus-ephemeral-run
