PROFILE_ID=windows-x64
OS_FAMILY=windows
BASE_IMAGE=windows11-25h2-evaluation-amd64
MEMORY_MIB=8192
VCPUS=4
DISK_GIB=80
DISPLAY=vnc-unix
NIC_MODEL=e1000
NETWORK_MODE=lab-nat-before-seal
POST_SEAL_WAN=disabled
QMP_SOCKET=qmp/windows11.sock
QGA_SOCKET=qga/windows11.sock
UEFI=on
OVMF_CODE=/usr/share/OVMF/OVMF_CODE_4M.ms.fd
OVMF_VARS=/var/lib/amnezia-release-lab/guests/windows11/OVMF_VARS_4M.ms.fd
TPM=on
TPM_VERSION=2.0
SECURE_BOOT_KEYS=Microsoft-signed-OVMF
SNAPSHOT_POLICY=golden-read-only-plus-ephemeral-run
# Do not enable test-signing or inject unsigned VirtIO drivers.
DRIVER_POLICY=signed-only
