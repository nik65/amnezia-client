PROFILE_ID=server-router
OS_FAMILY=linux
BASE_IMAGE=ubuntu24-cloud-amd64
MEMORY_MIB=4096
VCPUS=2
DISK_GIB=24
DISPLAY=none
NIC_MODEL=e1000
NETWORK_MODE=isolated-test-server-router
POST_SEAL_WAN=disabled
QMP_SOCKET=qmp/server-router.sock
QGA_SOCKET=qga/server-router.sock
UEFI=off
TPM=off
SNAPSHOT_POLICY=golden-read-only-plus-ephemeral-run
# The controller may attach a second guest-only test NIC, never a host bridge.
TEST_NIC=guest-only
