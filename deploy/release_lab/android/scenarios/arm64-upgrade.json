      "version": "5.0.1.37",
      "version_code": 2185,
      "apk_abi": "arm64-v8a",
      "install_mode": "adb-install-abi-explicit"
    },
    "update": {
      "package": "org.amnezia.vpn",
      "version": "5.0.1.38",
      "version_code": 2186,
      "apk_abi": "arm64-v8a",
      "install_mode": "app-selfhosted-update-to-system-package-installer-ui",
      "persistent_external_marker": true,
      "native_bridge_live_log": true,
      "manifest_get": true,
